PORT=3000
# Public URL of your deployment (used in alert links)
BASE_URL=http://localhost:3000
DATA_DIR=./data

# Scheduler / politeness
WORKER_CONCURRENCY=2
DOMAIN_MIN_GAP_MS=10000
RESPECT_ROBOTS=true
MAX_MONITORS_PER_OWNER=25

# Alerts (all optional)
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Tidemark <alerts@example.com>"
TELEGRAM_BOT_TOKEN=
DIGEST_HOUR_UTC=3

# Optional one-line AI change summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
